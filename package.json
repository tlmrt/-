{
  "name": "evestudio-calendar",
  "version": "0.1.6",
  "description": "开源日历 — 桌面日历与任务到点提醒",
  "main": "src/main.js",
  "author": "EveStudio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/reminder.test.js && node test/festivals.test.js && node test/holidays.test.js && node test/updater.test.js && node test/autostart.test.js && node test/maa.test.js && node test/maaconfig.test.js && node test/localapi.test.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "cn.evestudio.calendar",
    "productName": "开源日历",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "extras/**/*",
      "docs/**/*",
      "!node_modules/**/{test,__tests__,tests,example,examples,docs,doc}/**",
      "!node_modules/**/*.md",
      "!node_modules/**/*.map",
      "!node_modules/**/{.github,.vscode,.idea}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "开源日历",
      "artifactName": "开源日历 Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "开源日历 便携版 ${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "lunar-javascript": "^1.7.7"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
